# Copy to .env (scripts/setup-db.ps1 does this for you and fills in the database URLs).
# .env is git-ignored: never commit real passwords.

# PostgreSQL connection strings (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://persona_app:CHANGE_ME@localhost:5432/persona_os
TEST_DATABASE_URL=postgresql+psycopg://persona_app:CHANGE_ME@localhost:5432/persona_os_test

# Where the React app runs (used for CORS and in password-reset links)
FRONTEND_ORIGIN=http://localhost:5173

# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Create the demo/cyber2077 account on startup
SEED_DEMO_USER=true
